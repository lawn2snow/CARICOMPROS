    {
      "parameters": {
        "jsCode": "// Calculate platform statistics\nconst payments = $input.all();\n\nlet totalRevenue = 0;\nlet platformFees = 0;\nlet contractorPayouts = 0;\nlet totalJobs = payments.length;\n\nfor (const payment of payments) {\n  totalRevenue += parseFloat(payment.json.TotalAmount) || 0;\n  platformFees += parseFloat(payment.json.PlatformFee) || 0;\n  contractorPayouts += parseFloat(payment.json.ContractorPayout) || 0;\n}\n\nreturn [{\n  json: {\n    totalRevenue: totalRevenue.toFixed(2),\n    platformFees: platformFees.toFixed(2),\n    contractorPayouts: contractorPayouts.toFixed(2),\n    totalJobsCompleted: totalJobs,\n    averageJobValue: totalJobs > 0 ? (totalRevenue / totalJobs).toFixed(2) : 0\n  }\n}];"
      },
      "id": "code-calculate-stats",
      "name": "Calculate Platform Stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [760, 2700]
    },
