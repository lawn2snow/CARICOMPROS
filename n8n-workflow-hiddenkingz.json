    {
      "parameters": {
        "jsCode": "// Calculate platform fee (10%) and contractor payout\nconst jobAmount = $input.first().json.amount || 0;\nconst platformFee = jobAmount * 0.10;\nconst contractorPayout = jobAmount * 0.90;\n\nreturn [{\n  json: {\n    ...$input.first().json,\n    jobAmount: jobAmount,\n    platformFee: platformFee,\n    contractorPayout: contractorPayout,\n    payoutDate: new Date().toISOString()\n  }\n}];"
      },
      "id": "code-calculate-payout",
      "name": "Calculate Payout (10% Fee)",
